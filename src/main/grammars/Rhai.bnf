{
  parserClass="org.rhai.RhaiParser"

  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="Rhai"
  psiImplClassSuffix="Impl"
  psiPackage="org.rhai"
  psiImplPackage="org.rhai.impl"

  elementTypeHolderClass="org.rhai.RhaiTypes"
  elementTypeClass="org.rhai.RhaiElementType"
  tokenTypeClass="org.rhai.RhaiTokenType"

  consumeTokenMethod(".*")="consumeToken"

   tokens = [
      // Скобки
      LPAREN='('
      RPAREN=')'
      LBRACKET='['
      RBRACKET=']'
      LBRACE='{'
      RBRACE='}'

      // Операторы
      PLUS='+'
      MINUS='-'
      MUL='*'
      DIV='/'
      MOD='%'
      ASSIGN='='
      NOT='!'
      BAND='&'
      BOR='|'
      BXOR='^'
      LT='<'
      GT='>'
      DOT='.'
      COLON=':'
      SEMICOLON=';'
      COMMA=','

      // Составные операторы
      ARROW='=>'
      DOUBLE_COLON='::'
      POW='**'
      SHL_ASSIGN='<<='
      SHR_ASSIGN='>>='
      SHL='<<'
      SHR='>>'
      LE='<='
      GE='>='
      EQ='=='
      NE='!='
      PLUS_ASSIGN='+='
      MINUS_ASSIGN='-='
      MUL_ASSIGN='*='
      DIV_ASSIGN='/='
      MOD_ASSIGN='%='
      AND_ASSIGN='&='
      OR_ASSIGN='|='
      XOR_ASSIGN='^='
      AND='&&'
      OR='||'

      // Ключевые слова
      FN='fn'
      PRIVATE='private'
      CONST='const'
      LET='let'
      IF='if'
      ELSE='else'
      SWITCH='switch'
      DEFAULT='default'
      RETURN='return'
      THROW='throw'
      TRY='try'
      CATCH='catch'
      FOR='for'
      IN='in'
      LOOP='loop'
      DO='do'
      WHILE='while'
      UNTIL='until'
      BREAK='break'
      CONTINUE='continue'
      IMPORT='import'
      EXPORT='export'
      AS='as'
      THIS='this'
      GLOBAL='global'
      TRUE='true'
      FALSE='false'

      // Литералы
      NUMBER='NUMBER'
      STRING='STRING'
      CHAR_LITERAL_TOKEN='CHAR_LITERAL_TOKEN'
      CONSTANT='CONSTANT'
      IDENTIFIER='identifier'
      SHEBANG_TOKEN='SHEBANG_TOKEN'

      // Комментарии
      BLOCK_COMMENT='BLOCK_COMMENT'
      DOC_COMMENT='DOC_COMMENT'
      DOC_LINE='DOC_LINE'
      LINE_COMMENT='LINE_COMMENT'

      // Интерполированные строки
      INTERPOLATED_START='INTERPOLATED_START'
      INTERPOLATED_END='INTERPOLATED_END'
      INTERPOLATED_EXPR_START='INTERPOLATED_EXPR_START'
      INTERPOLATED_EXPR_END='INTERPOLATED_EXPR_END'
      INTERPOLATED_TEXT='INTERPOLATED_TEXT'

      // Прочие
      BUILTIN='BUILTIN'
      RESERVED='RESERVED'
      INVALID_OP='INVALID_OP'
      INVALID_ESCAPE='INVALID_ESCAPE'

       STRING_START='STRING_START'
       STRING_END='STRING_END'
       STRING_CONTENT='STRING_CONTENT'
       STRING_ESCAPE='STRING_ESCAPE'
       STRING_ESCAPE_NEWLINE='STRING_ESCAPE_NEWLINE'

        // Для интерполированных строк (между INTERPOLATED_TEXT и BUILTIN)
       INTERPOLATED_CONTENT='INTERPOLATED_CONTENT'  // или замените INTERPOLATED_TEXT на это
       INTERPOLATED_ESCAPE='INTERPOLATED_ESCAPE'
       INTERPOLATED_ESCAPE_NEWLINE='INTERPOLATED_ESCAPE_NEWLINE'

        // Ошибки
       INVALID_ESCAPE='INVALID_ESCAPE'
    ]
}

// Root
rhaiFile ::= shebang? top_level_item*

private top_level_item ::= function_definition
                         | import_statement
                         | export_statement
                         | statement
                         | ';'

shebang ::= shebang_token
private shebang_token ::= SHEBANG_TOKEN

// Import/Export
import_statement ::= 'import' import_path ('as' identifier)? ';'?
                   | 'import' import_path '::' '*' ';'?
import_path ::= identifier ('::' identifier)*

export_statement ::= 'export' (function_definition | const_declaration | let_declaration)

// Function definition: fn name(args) { body }
function_definition ::= 'private'? 'fn' identifier '(' parameters? ')' block?

parameters ::= parameter (',' parameter)* ','?
parameter ::= identifier

// Statements
statement ::= let_declaration
            | const_declaration
            | expression_statement
            | if_statement
            | switch_statement
            | while_statement
            | do_while_statement
            | until_statement
            | loop_statement
            | for_statement
            | break_statement
            | continue_statement
            | return_statement
            | throw_statement
            | try_catch_statement
            | labeled_statement
            | block

// Variable declarations
let_declaration ::= 'let' pattern ('=' expression)? ';'?
const_declaration ::= 'const' pattern ('=' expression)? ';'?
pattern ::= identifier | '_' | CONSTANT

// Labeled statements: 'label: loop { ... }' or '"string label": while ...'
labeled_statement ::= label ':' statement
label ::= identifier | string_literal

// Control flow
if_statement ::= 'if' expression block ('else' (if_statement | block))?
switch_statement ::= 'switch' expression '{' switch_arm* default_arm? '}'
switch_arm ::= expression '=>' (expression | block) ','?
default_arm ::= 'default' '=>' (expression | block) ','?

while_statement ::= 'while' expression block
do_while_statement ::= 'do' block 'while' expression ';'?
until_statement ::= 'until' expression block
loop_statement ::= 'loop' block
for_statement ::= 'for' identifier 'in' expression block

break_statement ::= 'break' (expression | identifier)? ';'?
continue_statement ::= 'continue' ';'?
return_statement ::= 'return' expression? ';'?
throw_statement ::= 'throw' expression ';'?
try_catch_statement ::= 'try' block 'catch' '(' identifier ')' block

block ::= '{' statement* '}'

// Expressions (precedence climbing, low to high)
expression ::= assignment_expr

// Assignment (right associative)
assignment_expr ::= pipe_expr (assignment_op assignment_expr)?
assignment_op ::= '=' | '+=' | '-=' | '*=' | '/=' | '%=' | '&=' | '|=' | '^=' | '<<=' | '>>='

// Arrow (switch arms, closure shorthand)
pipe_expr ::= or_expr ('=>' or_expr)*

// Logical OR/AND
or_expr ::= and_expr (('||') and_expr)*
and_expr ::= eq_expr (('&&') eq_expr)*

// Equality/Relational
eq_expr ::= rel_expr (('==' | '!=') rel_expr)*
rel_expr ::= bit_or_expr (('<' | '>' | '<=' | '>=') bit_or_expr)*

// Bitwise
bit_or_expr ::= bit_xor_expr (('|') bit_xor_expr)*
bit_xor_expr ::= bit_and_expr (('^') bit_and_expr)*
bit_and_expr ::= shift_expr (('&') shift_expr)*

// Shift
shift_expr ::= add_expr (('<<' | '>>') add_expr)*

// Additive/Multiplicative
add_expr ::= mul_expr (('+' | '-') mul_expr)*
mul_expr ::= power_expr (('*' | '/' | '%') power_expr)*

// Power (right associative)
power_expr ::= unary_expr ('**' power_expr)?

// Unary
unary_expr ::= ('!' | '-' | '+') unary_expr | postfix_expr

// Postfix: calls, indexing, field access
postfix_expr ::= primary_expr postfix_op*
postfix_op ::= '(' argument_list? ')' capture_flag?   // fn!() - capture syntax
             | '.' identifier                        // field access
             | '[' expression ']'                    // index

capture_flag ::= '!'
argument_list ::= expression (',' expression)* ','?

// Primary expressions
primary_expr ::= literal
               | identifier
               | BUILTIN
               | path_expression
               | 'this'
               | 'global'
               | '(' expression? ')'  // grouping or unit
               | array_literal
               | object_literal
               | closure_expr
               | interpolated_string

// Path: std::foo::bar
path_expression ::= identifier ('::' identifier)+

// Literals
literal ::= numeric_literal
          | string_literal
          | char_literal
          | boolean_literal

numeric_literal ::= NUMBER
string_literal ::= STRING_START string_content* STRING_END
private string_content ::= STRING_CONTENT | STRING_ESCAPE | STRING_ESCAPE_NEWLINE
char_literal ::= char_literal_token
private char_literal_token ::= CHAR_LITERAL_TOKEN
boolean_literal ::= 'true' | 'false'

array_literal ::= '[' array_elements? ']'
array_elements ::= expression (',' expression)* ','?

object_literal ::= '{' object_fields? '}'
object_fields ::= object_field (',' object_field)* ','?
object_field ::= (identifier | string_literal) ':' expression

// Closure: |x, y| x + y  or  |x| { block }
closure_expr ::= '|' closure_params? '|' closure_body
closure_params ::= closure_param (',' closure_param)* ','?
closure_param ::= identifier
closure_body ::= expression | block

// Interpolated string: `text ${expr} text`
interpolated_string ::= INTERPOLATED_START interpolated_part* INTERPOLATED_END
interpolated_part ::= INTERPOLATED_TEXT
                    | INTERPOLATED_EXPR_START expression '}'

// Expression statement (semicolon optional in some contexts)
expression_statement ::= expression ';'?